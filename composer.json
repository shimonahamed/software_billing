
{
  "name": "shimonahamed/software-billing",
  "description": "Laravel software billing package",
  "type": "library",
  "license": "proprietary",

  "require": {
    "php": "^8.0",
    "illuminate/support": "^9.0 || ^10.0 || ^11.0 || ^12.0",
    "illuminate/database": "^9.0 || ^10.0 || ^11.0 || ^12.0"
  },
  "autoload": {
    "psr-4": {
      "SoftwareBilling\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "SoftwareBilling\\SoftwareBillingServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
